{
  "info": {
    "name": "Bookstore API - Reading List",
    "description": "Authenticated, owner-scoped reading-list operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "bookId", "value": "" },
    { "key": "itemId", "value": "" }
  ],
  "item": [
    {
      "name": "List my reading list",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/me/reading-list"
      }
    },
    {
      "name": "Add book to my reading list",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('itemId', pm.response.json().entry.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": \"{{bookId}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/me/reading-list"
      }
    },
    {
      "name": "Update my reading-list item",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"READING\",\n  \"notes\": \"Started reading\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/me/reading-list/{{itemId}}"
      }
    },
    {
      "name": "Remove item from my reading list",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/me/reading-list/{{itemId}}"
      }
    }
  ]
}
