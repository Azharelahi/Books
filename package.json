{
  "name": "bookstore-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && node scripts/clean-dist.mjs && tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node scripts/test.mjs",
    "db:test:setup": "node scripts/test-db-setup.mjs",
    "typecheck": "prisma generate && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:seed": "prisma db seed",
    "db:seed:catalog": "tsx scripts/seed-demo-catalog.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
